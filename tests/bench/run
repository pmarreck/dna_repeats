#!/usr/bin/env bash
# Tests for the scoreboard's scorer (bench/score.awk) on hand-computed fixtures.
set -u
cd "$(dirname "$0")/../.." || exit 1
fails=0
check() { if [ "$2" = "$3" ]; then printf 'ok   %s\n' "$1"; else printf 'FAIL %s: got [%s] want [%s]\n' "$1" "$2" "$3"; fails=$((fails + 1)); fi; }

# Truth: accession, organism, start (1-based), length, orientation, evidence level, DR.
truth=$'A\torg\t101\t100\t1\t4\tDR\nA\torg\t501\t100\t1\t1\tDR\nA\torg\t1001\t100\t1\t4\tDR\nB\torg\t1\t50\t1\t4\tDR'
# Predictions: accession, start, end (1-based, inclusive).
#  A 120-210: covers 81 of the first level-4 array (recalled); 81 of its 91 bases are inside truth (correct).
#  A 520-530: inside the level-1 array (correct; recall is only over level 4).
#  A 2000-2100: outside every array (wrong).
#  A 1001-1040: 40% of the second level-4 array (not recalled); fully inside it (correct).
#  B has no predictions, so its level-4 array is missed.
preds=$'A\t120\t210\nA\t520\t530\nA\t2000\t2100\nA\t1001\t1040'
got=$(${AWK:-awk} -f bench/score.awk <(printf '%s\n' "$truth") <(printf '%s\n' "$preds") | tail -1)
check totals "$got" $'TOTAL\tel4=3\trecalled=1\tpredictions=4\tcorrect=3\tcorrect_el4=2'

got=$(${AWK:-awk} -f bench/score.awk <(printf '%s\n' "$truth") <(printf '%s\n' "$preds") | head -1)
check per-accession "$got" $'A\tel4=2\trecalled=1\tpredictions=4\tcorrect=3\tcorrect_el4=2'

# Two predictions each covering half of one array jointly recall it (coverage is a union).
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tDR\n') <(printf 'C\t1\t50\nC\t51\t100\n') | tail -1)
check union-coverage "$got" $'TOTAL\tel4=1\trecalled=1\tpredictions=2\tcorrect=2\tcorrect_el4=2'

# Overlapping predictions do not double-count coverage: 1-40 twice is 40%, not 80%.
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tDR\n') <(printf 'C\t1\t40\nC\t1\t40\n') | tail -1)
check no-double-count "$got" $'TOTAL\tel4=1\trecalled=0\tpredictions=2\tcorrect=2\tcorrect_el4=2'

# Precision takes the union of truth coverage too: two truth rows over the same 40 bases of
# a 100-base prediction put 40%, not 80%, of it inside truth (wrong).
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t40\t1\t4\tDR\nC\to\t1\t40\t1\t1\tDR\n') <(printf 'C\t1\t100\n') | tail -1)
check precision-union "$got" $'TOTAL\tel4=1\trecalled=1\tpredictions=1\tcorrect=0\tcorrect_el4=0'

# Predictions on a sequence with no truth rows are wrong, not ignored (negative controls rely on it).
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tDR\n') <(printf 'C\t1\t100\nZ\t5\t50\n') | tail -1)
check truthless-predictions-count "$got" $'TOTAL\tel4=1\trecalled=1\tpredictions=2\tcorrect=1\tcorrect_el4=1'

# Repeat (DR) accuracy: a prediction with a 4th column (its unit) that overlaps a truth array
# with a DR is scored by Levenshtein distance to that DR on the closer strand.
#  1-30 exact; 31-60 one substitution; 61-90 reverse complement (exact); 91-100 one deletion;
#  Z (no truth) and a unit-less prediction are not scored.
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tAACGTTTG\n') <(printf 'C\t1\t30\tAACGTTTG\nC\t31\t60\tAACGATTG\nC\t61\t90\tCAAACGTT\nC\t91\t100\tAACGTTT\nZ\t1\t9\tAACGTTTG\nC\t1\t9\n') | grep '^DR')
check dr-accuracy "$got" $'DR\tscored=4\texact=2\tedit=2'
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tACGT\n') <(printf 'C\t1\t50\n') | grep '^DR')
check dr-none-without-units "$got" $'DR\tscored=0\texact=0\tedit=0'

# bench/shuffle-fasta: per-record permutation (same length and base counts), deterministic by seed.
fa=$'>r1 desc\nACGTACGTAAAACCCG\nTTTT\n>r2\nGGGGCCCCAATT\n'
one=$(printf '%s' "$fa" | bash bench/shuffle-fasta 7)
two=$(printf '%s' "$fa" | bash bench/shuffle-fasta 7)
other=$(printf '%s' "$fa" | bash bench/shuffle-fasta 8)
counts() { awk '/^>/ {name=$1; next} {s[name] = s[name] $0} END {for (n in s) {c = s[n]; printf "%s %d A%d C%d G%d T%d\n", n, length(c), gsub(/A/,"",c), gsub(/C/,"",c), gsub(/G/,"",c), gsub(/T/,"",c)}}' | sort; }
check shuffle-permutes "$(printf '%s\n' "$one" | counts)" "$(printf '%s' "$fa" | counts)"
check shuffle-deterministic "$one" "$two"
[ "$one" != "$other" ] && check shuffle-seed-matters ok ok || check shuffle-seed-matters same different
[ "$(printf '%s\n' "$one" | grep -v '^>' | tr -d '\n')" != "$(printf '%s' "$fa" | grep -v '^>' | tr -d '\n')" ] && check shuffle-changes-order ok ok || check shuffle-changes-order unchanged changed

# No truth and no predictions (a clean negative control) still yields numeric totals.
got=$(${AWK:-awk} -f bench/score.awk /dev/null /dev/null | tail -1)
check empty-inputs-numeric "$got" $'TOTAL\tel4=0\trecalled=0\tpredictions=0\tcorrect=0\tcorrect_el4=0'

# An empty truth file must not make the predictions be read as truth (FNR == NR trap).
got=$(${AWK:-awk} -f bench/score.awk /dev/null <(printf 'Z\t5\t50\n') | tail -1)
check empty-truth-predictions-are-wrong "$got" $'TOTAL\tel4=0\trecalled=0\tpredictions=1\tcorrect=0\tcorrect_el4=0'

# bench/plant-arrays SEED N_ARRAYS RATE_PERCENT OUT_PREFIX: FASTA plus CRISPRCasdb-style truth.
pdir=$(mktemp -d "${TMPDIR:-/tmp}/plant-test.XXXXXX") || exit 1
trap 'rm -r "$pdir"' EXIT
pa="$pdir/p"
bash bench/plant-arrays 3 4 0 "$pa"
check plant-array-count "$(wc -l <"$pa.truth.tsv" | tr -d ' ')" 4
seq=$(grep -v '^>' "$pa.fa" | tr -d '\n')
ok=1
while IFS=$'\t' read -r acc org start len orient el dr; do
	[ "${seq:$((start - 1)):${#dr}}" = "$dr" ] || ok=0
	[ "${seq:$((start + len - 1 - ${#dr})):${#dr}}" = "$dr" ] || ok=0 # last copy ends the array
done <"$pa.truth.tsv"
check plant-exact-copies-at-rate-0 "$ok" 1
bash bench/plant-arrays 3 4 0 "$pa.2"
check plant-deterministic "$(cat "$pa.fa" "$pa.truth.tsv" | sha256sum)" "$(cat "$pa.2.fa" "$pa.2.truth.tsv" | sha256sum)"

# bench/scoreboard on an ad-hoc set with a fake dna-repeats (DNAREPEATS_BIN), logging to
# SCOREBOARD_LOG: a tool that fails must fail the run loudly, and every log row carries
# provenance (tool path, input checksum, failure count).
sb="$pdir/sb"
mkdir -p "$sb/genomes"
printf '>g1\nACGT\n' >"$sb/genomes/g1.fa"
printf '>g2\nACGT\n' >"$sb/genomes/g2.fa"
printf 'g1\to\t1\t10\t1\t4\tACGT\ng2\to\t1\t10\t1\t4\tACGA\n' >"$sb/truth.tsv"
sh=$(command -v bash)
printf '#!%s\nprintf "%%s\\t1\\t10\\t3\\t4\\tACGT\\t1\\n" "$(basename "${@: -1}" .fa)"\n' "$sh" >"$sb/good"
printf '#!%s\ncase "$*" in *g2.fa*) echo "boom" >&2; exit 3 ;; esac\nprintf "g1\\t1\\t10\\t3\\t4\\tACGT\\t1\\n"\n' "$sh" >"$sb/bad"
chmod +x "$sb/good" "$sb/bad"
sbrun() { DNAREPEATS_BIN="$sb/$1" SCOREBOARD_LOG="$sb/log" bash bench/scoreboard --genomes "$sb/genomes" --truth "$sb/truth.tsv" --label t dnarepeats >"$sb/out" 2>"$sb/err"; }
sbrun good
check scoreboard-good-exit "$?" 0
check scoreboard-good-recall "$(jq -r '"\(.recalled)/\(.el4) \(.failures)"' "$sb/log")" "2/2 0"
check scoreboard-strict-precision "$(jq -r '"\(.correct) \(.correct_el4)"' "$sb/log")" "2 2"
check scoreboard-dr-accuracy "$(jq -r '"\(.dr_scored) \(.dr_exact) \(.dr_edit)"' "$sb/log")" "2 1 1"
check scoreboard-tool-path "$(jq -r .tool_path "$sb/log")" "$sb/good"
check scoreboard-input-checksum "$(jq -r .input_sha256 "$sb/log" | grep -cE '^[0-9a-f]{64}$')" 1
check scoreboard-logs-cpus "$(jq -r '.cpus | type' "$sb/log")" number
check scoreboard-good-quiet "$(cat "$sb/err")" ""
sbrun bad
check scoreboard-bad-exit "$?" 1
check scoreboard-bad-failures "$(tail -1 "$sb/log" | jq -r .failures)" 1
check scoreboard-bad-names-genome "$(grep -c 'g2.fa' "$sb/err")" 1
check scoreboard-bad-shows-tool-stderr "$(grep -c boom "$sb/err")" 1

# bench/art-check classifies each locus by whether an --art array lies upstream of its RT with
# the rule bench/art-link uses: the gap from the array's near edge to the RT start codon, on the
# RT's strand, is 1..6000 (an array touching or crossing the start codon is not upstream).
# A classifier over arrays placed at both edges of the gap on both strands.
ac="$pdir/ac"
mkdir -p "$ac/genomes" "$ac/rows"
printf '# accession\tphage\tset\trt_strand\trt_start\tpaper_reports_array\texpected\n' >"$ac/loci.tsv"
i=0
# RT start codon at 10000. Plus strand: gap = 10000 - end; minus strand: gap = start - 10000.
while read -r strand start end want; do
	i=$((i + 1))
	printf '>g%d\nACGT\n' "$i" >"$ac/genomes/g$i.fa"
	printf 'g%d\t%d\t%d\t3\t20\tACGTACGTACGTACGTACGT\t%d\n' "$i" "$start" "$end" "$start" >"$ac/rows/g$i.tsv"
	printf 'g%d\tp%d\tt\t%s\t10000\tyes\t%s\n' "$i" "$i" "$strand" "$want" >>"$ac/loci.tsv"
done <<'CASES'
+ 3000 3999 none
+ 3000 4000 found
+ 9000 9999 found
+ 9000 10000 none
+ 9990 10400 none
+ 10001 10500 none
- 16001 16500 none
- 16000 16500 found
- 10001 10500 found
- 10000 10500 none
- 9500 10000 none
- 9000 9999 none
CASES
printf '#!%s\ncat "%s/rows/$(basename "${@: -1}" .fa).tsv"\n' "$sh" "$ac" >"$ac/fake"
chmod +x "$ac/fake"
got=$(DNAREPEATS_BIN="$ac/fake" bash bench/art-check --genomes "$ac/genomes" --loci "$ac/loci.tsv" 2>"$ac/err" | awk -F'\t' '{print $1 "=" $2}' | tr '\n' ' ')
check art-check-windows "$got" "g1=none g2=found g3=found g4=none g5=none g6=none g7=none g8=found g9=found g10=none g11=none g12=none "
check art-check-quiet "$(cat "$ac/err")" ""

# bench/art-link joins --art arrays with prodigal genes and PF00078 hits cut from windows
# named REC__WSTART__WEND (1-based). An RT is "upstream" when the array lies within 6 kb
# before its start codon on its own strand, "near" when it is otherwise within the window;
# coding is the fraction of the array's bases inside predicted genes.
al="$pdir/al"
mkdir -p "$al"
printf 'phA\t1001\t1500\t4\t20\tACGTACGTACGTACGTACGT\t1001,1121,1241,1361\nphB\t20001\t20600\t3\t30\tACGTACGTACGTACGTACGTACGTACGTAA\t20001,20201,20401\nphC\t5001\t5400\t3\t25\tACGTACGTACGTACGTACGTACGTA\t5001,5201,5301\nphA\t60001\t60400\t3\t20\tACGTACGTACGTACGTACGT\t60001,60151,60301\n' >"$al/arrays.tsv"
# Windows: phA__1__9500 (RT on + at genome 3001..4500: array ends 1500, 1501 bp before it: upstream);
# phB__12001__28600 (RT on - with start codon at genome 14000: array starts 6001 after it: near);
# phC__1__13400 (a gene covering genome 5101..5300 overlaps half the array; no RT).
cat >"$al/genes.gff" <<'GFF'
phA__1__9500	Prodigal_v2.6.3	CDS	3001	4500	100	+	0	ID=1_1;partial=00
phA__1__9500	Prodigal_v2.6.3	CDS	5001	5600	50	-	0	ID=1_2;partial=00
phB__12001__28600	Prodigal_v2.6.3	CDS	1000	2000	100	-	0	ID=2_1;partial=00
phC__1__13400	Prodigal_v2.6.3	CDS	5101	5300	60	+	0	ID=3_1;partial=00
GFF
printf '# tblout\nphA__1__9500_1 - RVT_1 PF00078.33 1.5e-20 70.1 0.1 1e-20 70 0.1 1 1 0 1 1 1 1 -\nphB__12001__28600_1 - RVT_1 PF00078.33 2e-9 30.1 0.1 1e-9 30 0.1 1 1 0 1 1 1 1 -\n' >"$al/hits.tbl"
got=$(luajit bench/art-link "$al/arrays.tsv" "$al/genes.gff" "$al/hits.tbl" 2>&1 | cut -f1,2,8-11 | tr '\t' ' ')
check art-link "$got" "phA 1001 upstream 1501 1.5e-20 0.00
phB 20001 near 6001 2e-9 0.00
phC 5001 none - - 0.50
phA 60001 none - - 0.00"
printf 'phA__1__9500_1\tRVT-UG27\n' >"$al/classes.tsv"
got=$(luajit bench/art-link "$al/arrays.tsv" "$al/genes.gff" "$al/hits.tbl" "$al/classes.tsv" 2>&1 | cut -f1,2,12 | tr '\t' ' ')
check art-link-rt-class "$got" "phA 1001 RVT-UG27
phB 20001 -
phC 5001 -
phA 60001 -"

# bench/art-cluster groups census rows by repeat similarity on either strand: a repeat, a
# one-mismatch variant and its reverse complement form one family; an unrelated repeat its
# own. Families report members, genomes, RT-upstream members and known-ART similarity.
ak="$pdir/ak"
mkdir -p "$ak"
a=ATTATATGAATACGTATAATGA
b=ATTATATGAATACCTATAATGA   # one mismatch
rc=TCATTATACGTATTCATATAAT  # reverse complement of a
u=GGCCTTAGCACGGTCCAAGCTT   # unrelated
printf 'g1\t1\t900\t5\t22\t%s\tp\tupstream\t300\t1e-20\t0.00\ng2\t1\t900\t4\t22\t%s\tp\tnone\t-\t-\t0.00\ng3\t1\t900\t3\t22\t%s\tp\tnear\t-9000\t1e-9\t0.10\ng4\t1\t900\t3\t22\t%s\tp\tnone\t-\t-\t0.90\n' "$a" "$b" "$rc" "$u" >"$ak/census.tsv"
printf 'MarsHill\tATATGAATACGTATAAT\n' >"$ak/known.tsv"
got=$(luajit bench/art-cluster "$ak/census.tsv" "$ak/known.tsv" 2>&1 | cut -f1-5 | tr '\t' ' ')
check art-cluster "$got" "1 3 3 1 MarsHill
2 1 1 0 -"
luajit bench/art-cluster "$ak/census.tsv" "$ak/known.tsv" "$ak/members.tsv" >/dev/null 2>&1
check art-cluster-members "$(cut -f1,2 "$ak/members.tsv" | sort | tr '\t\n' ': ')" "1:g1 1:g2 1:g3 2:g4 "

# art-cluster must not chain (greedy centroid clustering, most copies first): A ~ B and
# B ~ C at 85% identity but A !~ C (70%), so A (most copies) takes B and C founds its own family.
ch="$pdir/ch"
mkdir -p "$ch"
B=ACGGTCATGCTTAGCCATGA
A=ACTGACTTGCTTAGCCATGA
C=ACGGTCATGCATCGACATGA
printf 'g1\t1\t900\t9\t20\t%s\tp\tnone\t-\t-\t0.00\ng2\t1\t900\t5\t20\t%s\tp\tnone\t-\t-\t0.00\ng3\t1\t900\t3\t20\t%s\tp\tnone\t-\t-\t0.00\n' "$A" "$B" "$C" >"$ch/census.tsv"
got=$(luajit bench/art-cluster "$ch/census.tsv" 2>&1 | cut -f1,2 | tr '\t\n' ': ')
check art-cluster-no-chaining "$got" "1:2 2:1 "

# art-reps: one representative array per family (most copies; the first on ties), its
# sequence cut from the genomes (plain or gzip), named FAMILY|REC:START-END.
rp="$pdir/rp"
mkdir -p "$rp"
printf '>g1 desc\nACGTACGTAC\nGGGGTTTTAA\n>g2\nCCCCCAAAAA\n' >"$rp/g.fa"
gzip -c "$rp/g.fa" >"$rp/g.fa.gz"
printf '1\tg1\t3\t12\t3\t2\tAC\n1\tg1\t1\t4\t5\t2\tAC\n1\tg2\t2\t4\t5\t2\tCC\n2\tg2\t6\t10\t2\t2\tAA\n' >"$rp/members.tsv"
check art-reps "$(luajit bench/art-reps "$rp/members.tsv" "$rp/g.fa")" \
	"$(printf '>1|g1:1-4\nACGT\n>2|g2:6-10\nAAAAA')"
check art-reps-gzip "$(luajit bench/art-reps "$rp/members.tsv" "$rp/g.fa.gz")" \
	"$(printf '>1|g1:1-4\nACGT\n>2|g2:6-10\nAAAAA')"

# art-annotate: each family row plus its representative locus, best included Rfam hit
# (lowest E-value, "!" only) and ARAGORN tRNA/tmRNA count.
an="$pdir/an"
mkdir -p "$an"
printf '1\t9\t8\t0\t-\t0.00\tAC\n2\t5\t4\t1\t-\t0.10\tAA\n3\t2\t2\t0\t-\t0.00\tGG\n' >"$an/fam.tsv"
printf '>1|g1:1-4\nACGT\n>2|g2:6-10\nAAAAA\n>3|g3:1-9\nGGGGGGGGG\n' >"$an/reps.fa"
cat >"$an/cm.tbl" <<'TBL'
#idx target name accession query name ...
1    tRNA                 RF00005   1|g1:1-4             -         CL00001    cm        1       71       11       83      +    no    1 0.63   0.0   65.6   7.6e-15  !   *       -      -      -      -      -      -      71      99 tRNA
2    5S_rRNA              RF00001   1|g1:1-4             -         -          cm        1       71       11       83      +    no    1 0.63   0.0   65.6   1.0e-20  ?   *       -      -      -      -      -      -      71      99 5S
3    tmRNA                RF00023   2|g2:6-10            -         -          cm        1       71       11       83      +    no    1 0.63   0.0   30.0   2e-05    !   *       -      -      -      -      -      -      71      99 tmRNA
4    Intron_gpII          RF00029   2|g2:6-10            -         -          cm        1       71       11       83      +    no    1 0.63   0.0   40.0   3e-08    !   *       -      -      -      -      -      -      71      99 group II
TBL
printf '>1|g1:1-4\n2 genes found\n1 tRNA-Ala [11,86]\n2 tRNA-Gly [100,170]\n>2|g2:6-10\n0 genes found\n>3|g3:1-9\n1 gene found\n1 tmRNA [1,300]\n>end \t3 sequences\n' >"$an/ara.txt"
# The optional CRISPR.tsv (dna-repeats --crispr on the representatives) adds a CRISPR array count.
printf '3|g3:1-9\t1\t9\t4\t36\tACCG\t1,2,3,4\n3|g3:1-9\t20\t90\t4\t36\tACCG\t1,2,3,4\n1|g1:1-4\t1\t4\t3\t30\tAC\t1,2,3\n' >"$an/crispr.tsv"
check art-annotate "$(luajit bench/art-annotate "$an/fam.tsv" "$an/reps.fa" "$an/cm.tbl" "$an/ara.txt")" \
	"$(printf '1\t9\t8\t0\t-\t0.00\tAC\tg1:1-4\ttRNA\t7.6e-15\t2\n2\t5\t4\t1\t-\t0.10\tAA\tg2:6-10\tIntron_gpII\t3e-08\t0\n3\t2\t2\t0\t-\t0.00\tGG\tg3:1-9\t-\t-\t1')"
check art-annotate-crispr "$(luajit bench/art-annotate "$an/fam.tsv" "$an/reps.fa" "$an/cm.tbl" "$an/ara.txt" "$an/crispr.tsv")" \
	"$(printf '1\t9\t8\t0\t-\t0.00\tAC\tg1:1-4\ttRNA\t7.6e-15\t2\t1\n2\t5\t4\t1\t-\t0.10\tAA\tg2:6-10\tIntron_gpII\t3e-08\t0\t0\n3\t2\t2\t0\t-\t0.00\tGG\tg3:1-9\t-\t-\t1\t2')"

# bench/art-census on a genome with arrays but no reverse transcriptase (a shuffled control
# can have none): fake tools on PATH, pinned models overridden by PFAM_RVT1_HMM and MYRT_HMM.
# hmmscan rejects an empty FASTA, as the real one does, so the classify step must skip it.
# One record and two workers: every worker FIFO must still get a writer (timeout: hang guard).
ce="$pdir/ce"
mkdir -p "$ce/bin"
printf '>g1\n%s\n' "$(printf 'ACGT%.0s' $(seq 1 100))" >"$ce/g.fa"
printf '#!%s\ngrep -q "^>" || exit 0\nprintf "g1\\t10\\t90\\t3\\t20\\tACGTACGTACGTACGTACGT\\t10,40,70\\n"\n' "$sh" >"$ce/bin/dna-repeats"
printf '#!%s\nwhile [ $# -gt 0 ]; do case $1 in -o) : >"$2"; shift ;; -a) : >"$2"; shift ;; esac; shift; done\n' "$sh" >"$ce/bin/prodigal"
printf '#!%s\nwhile [ $# -gt 0 ]; do case $1 in --tblout) echo "# no hits" >"$2"; shift ;; esac; shift; done\n' "$sh" >"$ce/bin/hmmsearch"
printf '#!%s\n[ -s "${@: -1}" ] || { echo "Error: Sequence file is empty" >&2; exit 1; }\n' "$sh" >"$ce/bin/hmmscan"
chmod +x "$ce/bin/dna-repeats" "$ce/bin/prodigal" "$ce/bin/hmmsearch" "$ce/bin/hmmscan"
got=$(PATH="$ce/bin:$PATH" IN_NIX_SHELL=1 DNAREPEATS_BIN="$ce/bin/dna-repeats" PFAM_RVT1_HMM=unused MYRT_HMM=unused \
	timeout 120 bash bench/art-census "$ce/g.fa" "$ce/out" -j 2 2>"$ce/err")
check art-census-no-rt-exit "$?" 0
check art-census-no-rt-summary "$got" "arrays: 1 (non-coding: 1); RT upstream (ART-like arrangement): 0; RT near: 0"

# art-context: proteins within 8 kb of each family member (ids), and per family the fraction of
# members with each Pfam domain on such a protein (tally). A gene outside every window counts
# for no family; a gene seen through two overlapping windows is scanned once.
cx="$pdir/cx"
mkdir -p "$cx"
printf '1\tg1\t9600\t9800\t3\n1\tg2\t2000\t2200\t3\n2\tg1\t18000\t18200\t4\n' >"$cx/members.tsv"
{
	printf 'g1__1__20000\tp\tCDS\t100\t400\t.\t+\t0\tx\n'
	printf 'g1__1__20000\tp\tCDS\t9000\t9500\t.\t+\t0\tx\n'
	printf 'g1__1__20000\tp\tCDS\t19000\t19900\t.\t-\t0\tx\n'
	printf 'g1__8001__30000\tp\tCDS\t11000\t11900\t.\t-\t0\tx\n'
	printf 'g2__1__5000\tp\tCDS\t1000\t1500\t.\t+\t0\tx\n'
} >"$cx/genes.gff"
check art-context-ids "$(luajit bench/art-context ids "$cx/members.tsv" "$cx/genes.gff" | tr '\n' ' ')" \
	"g1__1__20000_2 g1__1__20000_3 g2__1__5000_1 "
{
	echo '# target name accession query name'
	echo 'RVT_1  PF00078.33  g1__1__20000_2  -  1e-30  100.0'
	echo 'HTH_3  PF01381.28  g2__1__5000_1   -  1e-10  40.0'
	echo 'HTH_3  PF01381.28  g1__8001__30000_1  -  1e-10  40.0'
	echo 'Phage_integrase  PF00589.28  g1__1__20000_1  -  1e-20  70.0'
} >"$cx/pfam.tbl"
check art-context-tally "$(luajit bench/art-context tally "$cx/members.tsv" "$cx/genes.gff" "$cx/pfam.tbl")" \
	"$(printf '1\t2\tHTH_3\t1\t0.50\n1\t2\tRVT_1\t1\t0.50\n2\t1\tHTH_3\t1\t1.00')"

# shuffle-fasta-di: a dinucleotide-preserving shuffle (Altschul-Erickson). Every record keeps
# its header, length, first and last base and exact dinucleotide counts (counted here by an
# independent awk), is deterministic for a seed, and differs from its input.
di="$pdir/di"
mkdir -p "$di"
bash bench/plant-arrays 5 4 0 "$di/p" >/dev/null 2>&1
printf '>tiny\nAC\n>one\nG\n' >>"$di/p.fa"
luajit bench/shuffle-fasta-di 7 <"$di/p.fa" >"$di/s1.fa"
luajit bench/shuffle-fasta-di 7 <"$di/p.fa" >"$di/s2.fa"
luajit bench/shuffle-fasta-di 8 <"$di/p.fa" >"$di/s3.fa"
profile() { # per record: header, length, first, last, sorted dinucleotide counts
	awk '/^>/ {if (h) out(); h = $0; s = ""; next} {s = s toupper($0)} END {out()}
		function out(   i, d, k, line) { delete c; for (i = 1; i < length(s); i++) c[substr(s, i, 2)]++
			line = h " " length(s) " " substr(s, 1, 1) substr(s, length(s), 1)
			n = asorti(c, k); for (i = 1; i <= n; i++) line = line " " k[i] "=" c[k[i]]; print line }' "$1"
}
# Every seed of 1..8: a broken Eulerian walk fails on some seeds and survives others by luck.
want=$(profile "$di/p.fa")
bad=
for seed in 1 2 3 4 5 6 7 8; do
	[ "$(luajit bench/shuffle-fasta-di "$seed" <"$di/p.fa" 2>&1 | profile /dev/stdin)" = "$want" ] || bad="$bad $seed"
done
check di-profile-all-seeds "$bad" ""
check di-deterministic "$(sha256sum <"$di/s1.fa")" "$(sha256sum <"$di/s2.fa")"
check di-seed-matters "$([ "$(sha256sum <"$di/s1.fa")" != "$(sha256sum <"$di/s3.fa")" ] && echo differ)" differ
check di-changes-sequence "$([ "$(grep -v '^>' "$di/s1.fa" | tr -d '\n')" != "$(grep -v '^>' "$di/p.fa" | tr -d '\n' | tr a-z A-Z)" ] && echo differ)" differ

# art-context-run: only the chosen families' members, only their nearby proteins scanned
# (a fake hmmsearch reports one domain per protein, in hmmsearch's column order: the protein
# is the target, the domain the query).
cr="$pdir/cr"
mkdir -p "$cr/census" "$cr/bin"
cp "$cx/genes.gff" "$cr/census/genes.gff"
printf '>g1__1__20000_1 # x\nMK\n>g1__1__20000_2 # x\nMR\n>g1__1__20000_3 # x\nMS\n>g1__8001__30000_1 # x\nMS\n>g2__1__5000_1 # x\nMT\n' >"$cr/census/proteins.faa"
printf '#!%s\nwhile [ $# -gt 1 ]; do case $1 in --tblout) t=$2; shift ;; esac; shift; done\ngrep "^>" "$1" | sed "s/^>\\([^ ]*\\).*/\\1 - Dom PF0 1e-9 50/" >"$t"\n' "$sh" >"$cr/bin/hmmsearch"
chmod +x "$cr/bin/hmmsearch"
got=$(PATH="$cr/bin:$PATH" IN_NIX_SHELL=1 PFAM_A_HMM=unused bash bench/art-context-run "$cx/members.tsv" "$cr/census" "$cr/out" -j 2 2 2>"$cr/err")
check art-context-run-summary "$got" "families: 1; members: 1; proteins scanned: 1"
check art-context-run-context "$(cat "$cr/out/context.tsv")" "$(printf '2\t1\tDom\t1\t1.00')"
check art-context-run-quiet "$(cat "$cr/err")" ""

exit "$fails"
