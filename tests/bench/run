#!/usr/bin/env bash
# Tests for the scoreboard's scorer (bench/score.awk) on hand-computed fixtures.
set -u
cd "$(dirname "$0")/../.." || exit 1
fails=0
check() { if [ "$2" = "$3" ]; then printf 'ok   %s\n' "$1"; else printf 'FAIL %s: got [%s] want [%s]\n' "$1" "$2" "$3"; fails=$((fails + 1)); fi; }

# Truth: accession, organism, start (1-based), length, orientation, evidence level, DR.
truth=$'A\torg\t101\t100\t1\t4\tDR\nA\torg\t501\t100\t1\t1\tDR\nA\torg\t1001\t100\t1\t4\tDR\nB\torg\t1\t50\t1\t4\tDR'
# Predictions: accession, start, end (1-based, inclusive).
#  A 120-210: covers 81 of the first level-4 array (recalled); 81 of its 91 bases are inside truth (correct).
#  A 520-530: inside the level-1 array (correct; recall is only over level 4).
#  A 2000-2100: outside every array (wrong).
#  A 1001-1040: 40% of the second level-4 array (not recalled); fully inside it (correct).
#  B has no predictions, so its level-4 array is missed.
preds=$'A\t120\t210\nA\t520\t530\nA\t2000\t2100\nA\t1001\t1040'
got=$(${AWK:-awk} -f bench/score.awk <(printf '%s\n' "$truth") <(printf '%s\n' "$preds") | tail -1)
check totals "$got" $'TOTAL\tel4=3\trecalled=1\tpredictions=4\tcorrect=3'

got=$(${AWK:-awk} -f bench/score.awk <(printf '%s\n' "$truth") <(printf '%s\n' "$preds") | head -1)
check per-accession "$got" $'A\tel4=2\trecalled=1\tpredictions=4\tcorrect=3'

# Two predictions each covering half of one array jointly recall it (coverage is a union).
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tDR\n') <(printf 'C\t1\t50\nC\t51\t100\n') | tail -1)
check union-coverage "$got" $'TOTAL\tel4=1\trecalled=1\tpredictions=2\tcorrect=2'

# Overlapping predictions do not double-count coverage: 1-40 twice is 40%, not 80%.
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tDR\n') <(printf 'C\t1\t40\nC\t1\t40\n') | tail -1)
check no-double-count "$got" $'TOTAL\tel4=1\trecalled=0\tpredictions=2\tcorrect=2'

# Predictions on a sequence with no truth rows are wrong, not ignored (negative controls rely on it).
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tDR\n') <(printf 'C\t1\t100\nZ\t5\t50\n') | tail -1)
check truthless-predictions-count "$got" $'TOTAL\tel4=1\trecalled=1\tpredictions=2\tcorrect=1'

# Repeat (DR) accuracy: a prediction with a 4th column (its unit) that overlaps a truth array
# with a DR is scored by Levenshtein distance to that DR on the closer strand.
#  1-30 exact; 31-60 one substitution; 61-90 reverse complement (exact); 91-100 one deletion;
#  Z (no truth) and a unit-less prediction are not scored.
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tAACGTTTG\n') <(printf 'C\t1\t30\tAACGTTTG\nC\t31\t60\tAACGATTG\nC\t61\t90\tCAAACGTT\nC\t91\t100\tAACGTTT\nZ\t1\t9\tAACGTTTG\nC\t1\t9\n') | grep '^DR')
check dr-accuracy "$got" $'DR\tscored=4\texact=2\tedit=2'
got=$(${AWK:-awk} -f bench/score.awk <(printf 'C\to\t1\t100\t1\t4\tACGT\n') <(printf 'C\t1\t50\n') | grep '^DR')
check dr-none-without-units "$got" $'DR\tscored=0\texact=0\tedit=0'

# bench/shuffle-fasta: per-record permutation (same length and base counts), deterministic by seed.
fa=$'>r1 desc\nACGTACGTAAAACCCG\nTTTT\n>r2\nGGGGCCCCAATT\n'
one=$(printf '%s' "$fa" | bash bench/shuffle-fasta 7)
two=$(printf '%s' "$fa" | bash bench/shuffle-fasta 7)
other=$(printf '%s' "$fa" | bash bench/shuffle-fasta 8)
counts() { awk '/^>/ {name=$1; next} {s[name] = s[name] $0} END {for (n in s) {c = s[n]; printf "%s %d A%d C%d G%d T%d\n", n, length(c), gsub(/A/,"",c), gsub(/C/,"",c), gsub(/G/,"",c), gsub(/T/,"",c)}}' | sort; }
check shuffle-permutes "$(printf '%s\n' "$one" | counts)" "$(printf '%s' "$fa" | counts)"
check shuffle-deterministic "$one" "$two"
[ "$one" != "$other" ] && check shuffle-seed-matters ok ok || check shuffle-seed-matters same different
[ "$(printf '%s\n' "$one" | grep -v '^>' | tr -d '\n')" != "$(printf '%s' "$fa" | grep -v '^>' | tr -d '\n')" ] && check shuffle-changes-order ok ok || check shuffle-changes-order unchanged changed

# No truth and no predictions (a clean negative control) still yields numeric totals.
got=$(${AWK:-awk} -f bench/score.awk /dev/null /dev/null | tail -1)
check empty-inputs-numeric "$got" $'TOTAL\tel4=0\trecalled=0\tpredictions=0\tcorrect=0'

# An empty truth file must not make the predictions be read as truth (FNR == NR trap).
got=$(${AWK:-awk} -f bench/score.awk /dev/null <(printf 'Z\t5\t50\n') | tail -1)
check empty-truth-predictions-are-wrong "$got" $'TOTAL\tel4=0\trecalled=0\tpredictions=1\tcorrect=0'

# bench/plant-arrays SEED N_ARRAYS RATE_PERCENT OUT_PREFIX: FASTA plus CRISPRCasdb-style truth.
pdir=$(mktemp -d "${TMPDIR:-/tmp}/plant-test.XXXXXX") || exit 1
trap 'rm -r "$pdir"' EXIT
pa="$pdir/p"
bash bench/plant-arrays 3 4 0 "$pa"
check plant-array-count "$(wc -l <"$pa.truth.tsv" | tr -d ' ')" 4
seq=$(grep -v '^>' "$pa.fa" | tr -d '\n')
ok=1
while IFS=$'\t' read -r acc org start len orient el dr; do
	[ "${seq:$((start - 1)):${#dr}}" = "$dr" ] || ok=0
	[ "${seq:$((start + len - 1 - ${#dr})):${#dr}}" = "$dr" ] || ok=0 # last copy ends the array
done <"$pa.truth.tsv"
check plant-exact-copies-at-rate-0 "$ok" 1
bash bench/plant-arrays 3 4 0 "$pa.2"
check plant-deterministic "$(cat "$pa.fa" "$pa.truth.tsv" | sha256sum)" "$(cat "$pa.2.fa" "$pa.2.truth.tsv" | sha256sum)"

# bench/scoreboard on an ad-hoc set with a fake dna-repeats (DNAREPEATS_BIN), logging to
# SCOREBOARD_LOG: a tool that fails must fail the run loudly, and every log row carries
# provenance (tool path, input checksum, failure count).
sb="$pdir/sb"
mkdir -p "$sb/genomes"
printf '>g1\nACGT\n' >"$sb/genomes/g1.fa"
printf '>g2\nACGT\n' >"$sb/genomes/g2.fa"
printf 'g1\to\t1\t10\t1\t4\tACGT\ng2\to\t1\t10\t1\t4\tACGA\n' >"$sb/truth.tsv"
sh=$(command -v bash)
printf '#!%s\nprintf "%%s\\t1\\t10\\t3\\t4\\tACGT\\t1\\n" "$(basename "${@: -1}" .fa)"\n' "$sh" >"$sb/good"
printf '#!%s\ncase "$*" in *g2.fa*) echo "boom" >&2; exit 3 ;; esac\nprintf "g1\\t1\\t10\\t3\\t4\\tACGT\\t1\\n"\n' "$sh" >"$sb/bad"
chmod +x "$sb/good" "$sb/bad"
sbrun() { DNAREPEATS_BIN="$sb/$1" SCOREBOARD_LOG="$sb/log" bash bench/scoreboard --genomes "$sb/genomes" --truth "$sb/truth.tsv" --label t dnarepeats >"$sb/out" 2>"$sb/err"; }
sbrun good
check scoreboard-good-exit "$?" 0
check scoreboard-good-recall "$(jq -r '"\(.recalled)/\(.el4) \(.failures)"' "$sb/log")" "2/2 0"
check scoreboard-dr-accuracy "$(jq -r '"\(.dr_scored) \(.dr_exact) \(.dr_edit)"' "$sb/log")" "2 1 1"
check scoreboard-tool-path "$(jq -r .tool_path "$sb/log")" "$sb/good"
check scoreboard-input-checksum "$(jq -r .input_sha256 "$sb/log" | grep -cE '^[0-9a-f]{64}$')" 1
check scoreboard-logs-cpus "$(jq -r '.cpus | type' "$sb/log")" number
check scoreboard-good-quiet "$(cat "$sb/err")" ""
sbrun bad
check scoreboard-bad-exit "$?" 1
check scoreboard-bad-failures "$(tail -1 "$sb/log" | jq -r .failures)" 1
check scoreboard-bad-names-genome "$(grep -c 'g2.fa' "$sb/err")" 1
check scoreboard-bad-shows-tool-stderr "$(grep -c boom "$sb/err")" 1

exit "$fails"
