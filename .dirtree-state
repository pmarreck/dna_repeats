# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	CODE_REVIEW.md = Deep code review 2026-09-26: status table plus five reviewers' findings (memory, complexity, correctness, tests, structure)
	INTENT.md = Project purpose, constraints and verification
	LICENSE = MIT license, copyright 2026 Peter Marreck
	PLAN.md = Open work
	README.md = Project README: headline charts, quick start, usage, bench/verify, method, limits
	ZIG_RECENT_API_CHANGES.md = Symlink to Peter's Zig 0.14-0.16 API cheatsheet (Obsidian vault)
	bench = Benchmark inputs and logs: gen-corpus plus <machine-id>.ndjson history
	bench/art-census = ART census: --art arrays over a genome collection, prodigal on windows, PF00078 hmmsearch, art-link; summary
	bench/art-check = ART locus check: --art arrays within 6 kb upstream of each RT (strand-aware), per bench/art_loci.tsv
	bench/art-cluster = Repeat families across an ART census: canonical 8-mer index, containment identity on both strands, union-find
	bench/art-link = Joins arrays with gene calls and RT hits: RT relation (upstream/near/none), distance, E-value, coding fraction
	bench/art_known.tsv = Known ART repeats (paper and our detections) for labeling census families
	bench/art_loci.tsv = Known ART loci from Yoon et al. 2026: accession, tuning/held-out set, RT strand/start, expected result
	bench/charts = README charts: latest scoreboard rows -> docs/img/heldout3.svg and divergence.svg (LuaJIT, pure SVG renderers)
	bench/divergence = Divergence sweep: every tool at substitution rates 0-15% via bench/scoreboard ad-hoc sets
	bench/expected.tsv = Deterministic expected scoreboard results checked by bench/verify
	bench/gen-corpus = Deterministic synthetic DNA generator (integer LCG in awk) for benchmarks
	bench/plant-arrays = Divergence input: CRISPR-like arrays planted in random DNA at a per-base substitution rate, with exact truth
	bench/score.awk = Scoreboard scorer: union-coverage recall over EL4 arrays, precision over any-level arrays
	bench/scoreboard = CRISPR scoreboard: opponents and dna-repeats on pinned genomes, time/memory, recall/precision, ndjson log
	bench/shuffle-fasta = Negative-control input: per-record mononucleotide Fisher-Yates shuffle of FASTA, deterministic by seed
	bench/verify = One command to confirm the findings: reruns held-out #3, shuffled control and divergence; checks bench/expected.tsv
	bm = Benchmarks: ReleaseFast package on synthetic DNA; linear-scaling gate plus two-sided per-machine ndjson log
	build = Builds the ReleaseFast package through Nix
	build.zig = Zig build graph: oracle, normalizer, finder, CLI and differential tests against the pinned pcre2 fork
	build.zig.zon = Package manifest; pins github.com/pmarreck/pcre2 capture-history by commit
	flake.nix = Nix package and checks; fixed-output Zig dependency fetch
	intents/art_search.md = Direction: array-first search for ART-like repeat arrays; split, results
	intents/beat_existing_tools.md = Accepted direction: beat CRISPR finders, TRF and exact-repeat tools on speed and recall
	nix/benchdata.nix = Pinned scoreboard inputs: 8 CRISPR genomes (NCBI efetch) and CRISPRCasdb ground truth derived from its SQL dump
	nix/opponents.nix = Nix packages for the opponents: PILER-CR 1.06 and MinCED 0.4.2 from source, TRF from nixpkgs
	src/arrays.zig = CRISPR-style array caller: runs of copies within spacer bounds, distinct spacers, overlapping runs merged
	src/cli.zig = Pure CLI pieces: arg parser, --about line, progress-bar renderer, color/progress resolution, TSV/JSON writers
	src/differential_test.zig = Oracle vs the fork's real matcher
	src/explore.zig = Reports where family rules disagree on small subjects
	src/families.zig = Plain quadratic oracle for five repeat-family rules, plus the LNRS bound
	src/finder.zig = PCRE2 capture-history finder: JIT chain pattern, chain_packing Packer, widened-gap candidateStarts (+chunked parallel), per-length worker pool
	src/kmer_scan.zig = Pure-Zig candidate-start scan: 2-bit rolling k-mer codes in a sliding window; same answer as the PCRE2 existence regex, 12.7x faster
	src/main.zig = dna-repeats I/O adapter: stdio/file I/O, TTY detection, progress, debug banner; calls finder per length
	src/normalize.zig = Strict plain-input normalizer plus FASTA parser (records, IUPAC ambiguity -> N)
	test = Runs all Zig tests and the release build through Nix
	tests/bench/run = Hand-computed fixture tests for bench/score.awk (run in the Nix cli check)
	tests/cli/run = Bash CLI surface suite (options, stdio aliases, -o, progress/color); run by the Nix cli check
]
