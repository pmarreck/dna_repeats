#!/usr/bin/env bash
# Gene context of chosen repeat families (intents/art_search.md, ART 5d): the proteins within
# 8 kb of every member (bench/art-context ids, cut from the census proteins.faa) searched with
# Pfam-A 38.2 (hmmsearch, gathering thresholds), then per family the fraction of members with each
# domain nearby (bench/art-context tally). Writes OUTDIR/{members.tsv,ids.txt,proteins.faa,
# pfam.tbl,context.tsv}. usage:
#   bench/art-context-run MEMBERS.tsv CENSUS_DIR OUTDIR [-j THREADS] FAMILY...
#   env PFAM_A_HMM uses that (hmmpress-ed) model file instead of the pinned build.
set -u
cd "$(dirname "$0")/.." || exit 1
[ -n "${IN_NIX_SHELL:-}" ] || exec nix develop -c "$0" "$@"
usage="usage: art-context-run MEMBERS.tsv CENSUS_DIR OUTDIR [-j THREADS] FAMILY..."
members=${1:?$usage} census=${2:?$usage} out=${3:?$usage}
shift 3
threads=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
[ "${1:-}" = "-j" ] && { threads=${2:?$usage}; shift 2; }
[ $# -gt 0 ] || { echo "$usage" >&2; exit 2; }
pfam=${PFAM_A_HMM:-}
[ -n "$pfam" ] || { p=$(nix build .#pfamA --no-link --print-out-paths) && pfam=$p/Pfam-A.hmm; } || exit 1
mkdir -p "$out" || exit 1
awk -F'\t' -v list="$*" 'BEGIN {n = split(list, f, " "); for (i = 1; i <= n; i++) want[f[i]] = 1} $1 in want' "$members" >"$out/members.tsv"
[ -s "$out/members.tsv" ] || { echo "art-context-run: no members in families: $*" >&2; exit 1; }
luajit bench/art-context ids "$out/members.tsv" "$census/genes.gff" >"$out/ids.txt" || exit 1
awk 'FILENAME == ARGV[1] {want[$1] = 1; next} /^>/ {keep = (substr($1, 2) in want)} keep' "$out/ids.txt" "$census/proteins.faa" >"$out/proteins.faa"
# hmmsearch, not hmmscan: hmmscan rereads the whole pressed database for every protein (~96
# proteins in 22 min per core here); hmmsearch reads each model once. With gathering (bit-score)
# thresholds both report the same hits (39 of 39 pairs on a 95-protein check). Proteins are
# dealt into one chunk per worker, each searched by a single-threaded hmmsearch; its table
# (protein first) is rewritten domain first, as bench/art-context tally reads hmmscan's.
scan() {
	local i pids=() failed=0
	awk -v n="$threads" -v p="$out/chunk" '/^>/ {k = (r++) % n} {print > (p "." k)}' "$out/proteins.faa"
	for ((i = 0; i < threads; i++)); do
		[ -s "$out/chunk.$i" ] || continue
		hmmsearch --noali --cut_ga --cpu 1 --tblout "$out/pfam.$i" "$pfam" "$out/chunk.$i" >/dev/null &
		pids+=($!)
	done
	for i in "${pids[@]}"; do wait "$i" || failed=1; done
	for ((i = 0; i < threads; i++)); do [ -s "$out/chunk.$i" ] && cat "$out/pfam.$i"; done |
		awk '!/^#/ {print $3, $4, $1, $2, $5, $6}' >"$out/pfam.tbl"
	for ((i = 0; i < threads; i++)); do mv "$out/chunk.$i" "$out/pfam.$i" "$HOME/.Trash/" 2>/dev/null || true; done
	return "$failed"
}
: >"$out/pfam.tbl"
[ ! -s "$out/proteins.faa" ] || scan || { echo "art-context-run: hmmsearch failed" >&2; exit 1; }
luajit bench/art-context tally "$out/members.tsv" "$census/genes.gff" "$out/pfam.tbl" >"$out/context.tsv" || exit 1
echo "families: $#; members: $(wc -l <"$out/members.tsv"); proteins scanned: $(wc -l <"$out/ids.txt")"
