#!/usr/bin/env bash
# Deterministic synthetic DNA for benchmarks: bench/gen-corpus N [SEED]
# Uniform random bases with occasional (1 in ~300 steps) mutated copies of recent
# segments (8-20 bases, copied from up to 319 back) so repeat families exist.
# Integer LCG arithmetic only, so every awk yields identical bytes. Streams in O(N):
# only the last WINDOW bases are kept for copying, and lines are printed as they fill.
set -u
n=${1:?usage: gen-corpus N [SEED]}
seed=${2:-1}
awk -v n="$n" -v seed="$seed" '
function emit(str,   k) {
	for (k = 1; k <= length(str) && total < n; k++) {
		line = line substr(str, k, 1); total++
		if (length(line) == 60) { print line; line = "" }
	}
	win = win str
	if (length(win) > WINDOW) win = substr(win, length(win) - WINDOW + 1)
}
BEGIN {
	WINDOW = 400 # >= the farthest copy source, len + 299 <= 319
	split("A C G T", b, " ")
	s = seed % 2147483647; if (s <= 0) s += 2147483646
	made = 0; total = 0; line = ""; win = ""
	while (made < n) {
		s = (s * 16807) % 2147483647
		if (s % 300 == 0 && made > 340) {
			s = (s * 16807) % 2147483647; len = 8 + s % 13
			s = (s * 16807) % 2147483647; back = len + s % 300
			seg = substr(win, length(win) - back + 1, len)
			s = (s * 16807) % 2147483647
			if (s % 3 == 0) { p = 1 + s % len; seg = substr(seg, 1, p - 1) b[1 + int(s / 8) % 4] substr(seg, p + 1) }
		} else {
			s = (s * 16807) % 2147483647
			seg = b[1 + s % 4]
		}
		emit(seg); made += length(seg)
	}
	if (line != "") print line
}'
