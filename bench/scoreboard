#!/usr/bin/env bash
# CRISPR scoreboard (intents/beat_existing_tools.md): every tool on every pinned genome,
# wall time and peak memory from GNU time, recall/precision from bench/score.awk against
# CRISPRCasdb, appended to bench/scoreboard-<machine-id>.ndjson.
# usage: bench/scoreboard [--set dev|heldout|heldout2|heldout3|shuffled] [TOOL...]   (default: dev set, every tool below)
#        bench/scoreboard --genomes DIR --truth FILE --label NAME [TOOL...]   (ad-hoc set)
#   env: MINCED_BIN, PILERCR_BIN, DNAREPEATS_BIN use that binary instead of building it;
#        SCOREBOARD_LOG replaces the per-machine log. A tool failing on any genome is reported
#        with its stderr, counted in the log row (failures) and makes the run exit 1.
#   dev: the genomes filters are tuned on; heldout: the fixed held-out set used for claims.
#   shuffled: dev genomes with shuffled bases (negative control: every prediction is false).
set -u
cd "$(dirname "$0")/.." || exit 1
[ -n "${IN_NIX_SHELL:-}" ] || command -v jq >/dev/null || exec nix develop -c "$0" "$@"

build() { nix build ".#$1" --no-link --print-out-paths; }
set=dev
custom_genomes= custom_truth=
while [ $# -gt 0 ]; do
	case $1 in
		--set) set=${2:?--set needs a name}; shift 2 ;;
		--genomes) custom_genomes=${2:?}; shift 2 ;;
		--truth) custom_truth=${2:?}; shift 2 ;;
		--label) set=${2:?}; shift 2 ;;
		*) break ;;
	esac
done
if [ -n "$custom_genomes" ]; then genomes=$custom_genomes; truth=${custom_truth:?--genomes needs --truth}
else case $set in
	dev) genomes=$(build genomes) && truth=$(build crisprTruth) || exit 1 ;;
	heldout) genomes=$(build heldoutGenomes) && truth=$(build heldoutTruth) || exit 1 ;;
	heldout2) genomes=$(build heldout2Genomes) && truth=$(build heldout2Truth) || exit 1 ;;
	heldout3) genomes=$(build heldout3Genomes) && truth=$(build heldout3Truth) || exit 1 ;;
	shuffled) genomes=$(build shuffledGenomes) && truth=$(build emptyTruth) || exit 1 ;;
	*) echo "unknown set: $set" >&2; exit 2 ;;
esac
fi
tools=("$@")
[ ${#tools[@]} -gt 0 ] || tools=(minced pilercr dnarepeats dnarepeats_raw)
needs() { local t; for t in "${tools[@]}"; do [[ $t == "$1"* ]] && return 0; done; return 1; }
# Build only the tools asked for, unless an override names the binary.
minced=${MINCED_BIN:-} pilercr=${PILERCR_BIN:-} dnarepeats=${DNAREPEATS_BIN:-}
if needs minced && [ -z "$minced" ]; then p=$(build minced) || exit 1; minced=$p/bin/minced; fi
if needs pilercr && [ -z "$pilercr" ]; then p=$(build pilercr) || exit 1; pilercr=$p/bin/pilercr; fi
if needs dnarepeats && [ -z "$dnarepeats" ]; then p=$(build default) || exit 1; dnarepeats=$p/bin/dna-repeats; fi
readonly TIME=$(type -P gtime || type -P time) || { echo 'GNU time (gtime/time) not found' >&2; exit 1; }

# Each adapter: $1 = FASTA path; prints "accession<TAB>start<TAB>end<TAB>repeat unit"
# (1-based, inclusive).
predict_minced() { "$minced" -gff "$1" | awk -F'\t' '$3 == "repeat_region" {u = $9; sub(/.*rpt_unit_seq=/, "", u); sub(/;.*/, "", u); print $1 "\t" $4 "\t" $5 "\t" u}'; }
predict_pilercr() {
	"$pilercr" -in "$1" -out "$work/pilercr.txt" -quiet >/dev/null || return
	# SUMMARY BY POSITION rows are fixed-width: position at column 26, length at column 38.
	awk '/^SUMMARY BY POSITION/ {on = 1; next}
		on && /^>/ {acc = substr($1, 2); next}
		on && /^ *[0-9]+  / {pos = substr($0, 26, 10) + 0; len = substr($0, 38, 10) + 0; print acc "\t" pos "\t" pos + len - 1 "\t" $NF}' "$work/pilercr.txt"
}
# Array calling with the CRISPR preset.
predict_dnarepeats() { "$dnarepeats" --no-progress --crispr "$1" | awk -F'\t' '{print $1 "\t" $2 "\t" $3 "\t" $6}'; }
# The CRISPR preset on one thread (the opponents are single-threaded).
predict_dnarepeats_1t() { "$dnarepeats" --no-progress --crispr -j 1 "$1" | awk -F'\t' '{print $1 "\t" $2 "\t" $3 "\t" $6}'; }
# The --sensitive preset: seeds from 14 bases for degraded arrays.
predict_dnarepeats_sensitive() { "$dnarepeats" --no-progress --crispr --sensitive "$1" | awk -F'\t' '{print $1 "\t" $2 "\t" $3 "\t" $6}'; }
# Naive baseline: every family of >= 3 exact copies is one region (step 3 replaces this).
predict_dnarepeats_raw() {
	"$dnarepeats" --no-progress --min-len 23 --max-len 47 --max-gap 72 "$1" |
		awk -F'\t' '$3 >= 3 {n = split($5, p, ","); print $1 "\t" p[1] + 1 "\t" p[n] + $2 "\t" $4}'
}

work=$(mktemp -d "${TMPDIR:-/tmp}/scoreboard.XXXXXX") || exit 1
trap 'rm -r "$work"' EXIT
cpu=$(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null || sysctl -n machdep.cpu.brand_string 2>/dev/null)
machine=$(printf '%s|%s|%s' "$(uname -n | cut -d. -f1)" "$(uname -m)" "$cpu" | sha256sum | cut -c1-12)
# Logical CPUs: dna-repeats uses one thread per CPU by default.
cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)
log=${SCOREBOARD_LOG:-bench/scoreboard-$machine.ndjson}
commit=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
# Uncommitted changes (other than scoreboard logs) mean the commit does not describe the code.
dirty=$(git status --porcelain -- . ":!bench/scoreboard-*.ndjson" 2>/dev/null | grep -q . && echo true || echo false)
[ "$commit" = unknown ] && dirty=null
# Checksum of the inputs: each genome (name and bytes), then the truth file.
input_sha256=$(for fa in "$genomes"/*.fa; do printf "%s " "${fa##*/}"; sha256sum <"$fa"; done | cat - "$truth" | sha256sum | cut -c1-64)
status=0
when=$(date -Iseconds)

printf 'set: %s\n' "$set"
printf '%-16s %9s %8s %9s %9s %9s %10s %10s\n' tool recalled recall predicted precision wall_s peak_MB DR_exact
for tool in "${tools[@]}"; do
	: >"$work/$tool.pred"
	wall=0 peak=0 failures=0
	case $tool in minced) tool_path=$minced ;; pilercr) tool_path=$pilercr ;; *) tool_path=$dnarepeats ;; esac
	for fa in "$genomes"/*.fa; do
		"$TIME" -f '%e %M' -o "$work/time" bash -c "set -o pipefail; $(declare -f "predict_$tool"); $(declare -p minced pilercr dnarepeats work); predict_$tool '$fa'" >>"$work/$tool.pred" 2>"$work/err"
		rc=$?
		if [ "$rc" -ne 0 ]; then
			failures=$((failures + 1))
			{ printf 'scoreboard: %s failed on %s (exit %d):\n' "$tool" "$fa" "$rc"; sed 's/^/  /' "$work/err"; } >&2
		fi
		# GNU time puts "Command exited with non-zero status N" before the numbers on failure.
		read -r s kb < <(tail -1 "$work/time")
		wall=$(awk -v a="$wall" -v b="$s" 'BEGIN {print a + b}')
		[ "$kb" -gt "$peak" ] && peak=$kb
	done
	[ "$failures" -eq 0 ] || status=1
	awk -f bench/score.awk "$truth" "$work/$tool.pred" >"$work/score"
	score=$(tail -1 "$work/score")
	dr=$(grep '^DR' "$work/score")
	drn=$(sed 's/.*scored=\([0-9]*\).*/\1/' <<<"$dr"); drx=$(sed 's/.*exact=\([0-9]*\).*/\1/' <<<"$dr"); dre=$(sed 's/.*edit=\([0-9]*\).*/\1/' <<<"$dr")
	el4=$(sed 's/.*el4=\([0-9]*\).*/\1/' <<<"$score"); rec=$(sed 's/.*recalled=\([0-9]*\).*/\1/' <<<"$score")
	pred=$(sed 's/.*predictions=\([0-9]*\).*/\1/' <<<"$score"); cor=$(sed 's/.*correct=\([0-9]*\).*/\1/' <<<"$score")
	printf '%-16s %5d/%-3d %7.1f%% %9d %8.1f%% %9.2f %10.1f %9.1f%%%s\n' "$tool" "$rec" "$el4" \
		"$(awk -v a="$rec" -v b="$el4" 'BEGIN {print b ? 100 * a / b : 0}')" "$pred" \
		"$(awk -v a="$cor" -v b="$pred" 'BEGIN {print b ? 100 * a / b : 0}')" "$wall" "$(awk -v k="$peak" 'BEGIN {print k / 1024}')" \
		"$(awk -v a="$drx" -v b="$drn" 'BEGIN {print b ? 100 * a / b : 0}')" \
		"$([ "$failures" -eq 0 ] || printf '  FAILED on %d genomes' "$failures")"
	jq -cn --arg commit "$commit" --argjson dirty "$dirty" --arg when "$when" --arg machine "$machine" --arg set "$set" \
		--arg tool "$tool" --arg tool_path "$tool_path" --arg input_sha256 "$input_sha256" \
		--argjson el4 "$el4" --argjson recalled "$rec" --argjson predictions "$pred" --argjson correct "$cor" \
		--argjson wall_s "$wall" --argjson peak_kb "$peak" --argjson failures "$failures" \
		--argjson cpus "$cpus" --argjson dr_scored "$drn" --argjson dr_exact "$drx" --argjson dr_edit "$dre" \
		'{commit: $commit, dirty: $dirty, when: $when, machine: $machine, cpus: $cpus, set: $set, tool: $tool, tool_path: $tool_path, input_sha256: $input_sha256, el4: $el4, recalled: $recalled, predictions: $predictions, correct: $correct, wall_s: $wall_s, peak_kb: $peak_kb, failures: $failures, dr_scored: $dr_scored, dr_exact: $dr_exact, dr_edit: $dr_edit}' >>"$log"
done
exit "$status"
