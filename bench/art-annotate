#!/usr/bin/env luajit
-- Known-element screen of repeat families, counted over members: a family's representative
-- can be the one member that is a CRISPR array or a tRNA, so a label must say how many members
-- carry it. REPS.fa holds members as >FAMILY|REC:START-END (bench/art-reps --all), the
-- representative first. Each family row gains: representative locus, members scanned, the
-- Rfam model most members hit (cmscan --fmt 2 --tblout, "!" hits; ties by name, "-" if none),
-- members with an included Rfam hit, members with an ARAGORN (-w) tRNA/tmRNA, and with
-- CRISPR.tsv (dna-repeats --crispr on the same sequences) members with a CRISPR array.
-- usage: bench/art-annotate FAMILIES.tsv REPS.fa CMSCAN.tbl ARAGORN.txt [CRISPR.tsv]

local function main(fam_path, reps_path, tbl_path, ara_path, crispr_path)
	local locus, scanned = {}, {}
	for line in io.lines(reps_path) do
		local fam, loc = line:match("^>(%d+)|(%S+)")
		if fam then
			fam = tonumber(fam)
			locus[fam] = locus[fam] or loc
			scanned[fam] = (scanned[fam] or 0) + 1
		end
	end
	-- Sets of member names per family and per label.
	local rfam_members, rfam_models, trna, crispr = {}, {}, {}, {}
	local function mark(t, fam, member)
		t[fam] = t[fam] or {}
		t[fam][member] = true
	end
	for line in io.lines(tbl_path) do
		if line:sub(1, 1) ~= "#" then
			local f = {}
			for x in line:gmatch("%S+") do f[#f + 1] = x end
			-- fmt 2 columns: 2 target name, 4 query name, 19 inc
			local fam = tonumber((f[4] or ""):match("^(%d+)|"))
			if fam and f[19] == "!" then
				mark(rfam_members, fam, f[4])
				rfam_models[fam] = rfam_models[fam] or {}
				rfam_models[fam][f[2]] = rfam_models[fam][f[2]] or {}
				rfam_models[fam][f[2]][f[4]] = true
			end
		end
	end
	local cur
	for line in io.lines(ara_path) do
		if line:match("^>%d+|") then
			cur = line:match("^>(%S+)")
		elseif line:sub(1, 1) == ">" then
			cur = nil
		elseif cur then
			local n = tonumber(line:match("^(%d+) genes? found"))
			if n and n > 0 then mark(trna, tonumber(cur:match("^(%d+)|")), cur) end
		end
	end
	if crispr_path then
		for line in io.lines(crispr_path) do
			local member = line:match("^(%d+|[^\t]+)\t")
			if member then mark(crispr, tonumber(member:match("^(%d+)|")), member) end
		end
	end
	local function count(t) local n = 0; for _ in pairs(t or {}) do n = n + 1 end; return n end
	for line in io.lines(fam_path) do
		local fam = tonumber(line:match("^(%d+)\t"))
		local top, top_n = "-", 0
		for model, who in pairs(rfam_models[fam] or {}) do
			local n = count(who)
			if n > top_n or (n == top_n and model < top) then top, top_n = model, n end
		end
		local cols = { line, locus[fam] or "-", tostring(scanned[fam] or 0), top, tostring(count(rfam_members[fam])), tostring(count(trna[fam])) }
		if crispr_path then cols[#cols + 1] = tostring(count(crispr[fam])) end
		print(table.concat(cols, "\t"))
	end
end

local usage = "usage: art-annotate FAMILIES.tsv REPS.fa CMSCAN.tbl ARAGORN.txt [CRISPR.tsv]"
main(assert(arg[1], usage), assert(arg[2], usage), assert(arg[3], usage), assert(arg[4], usage), arg[5])
